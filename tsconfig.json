{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": []
  },
  "include": [
    "lib/**/*.js",
    "components/**/*.js",
    "tourney-init.js",
    "pwa.js",
    "nav-mobile.js",
    "nav-platform.js",
    "celebrate.js",
    "courses-db.js"
  ],
  "exclude": [
    "node_modules",
    ".claude",
    "SKILLS",
    "supabase/functions",
    "**/*.html"
  ]
}
