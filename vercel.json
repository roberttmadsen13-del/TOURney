{
  "redirects": [
    { "source": "/t/bova-2026/:path*", "destination": "/t/bova/:path*", "permanent": true },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "bova-app.vercel.app" }],
      "destination": "https://bova.greenskeeper.studio/t/bova/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/",       "destination": "/marketing.html" },
    { "source": "/create", "destination": "/create.html" },
    { "source": "/t/:slug/admin",      "destination": "/admin.html" },
    { "source": "/t/:slug/scoreboard", "destination": "/scoreboard.html" },
    { "source": "/t/:slug/scorecard",  "destination": "/scorecard.html" },
    { "source": "/t/:slug/profile",    "destination": "/profile.html" },
    { "source": "/t/:slug/directory",  "destination": "/directory.html" },
    { "source": "/t/:slug/course",     "destination": "/course.html" },
    { "source": "/t/:slug/champions",  "destination": "/champions.html" },
    { "source": "/t/:slug/feed",       "destination": "/feed.html" },
    { "source": "/t/:slug/login",      "destination": "/login.html" },
    { "source": "/t/:slug/install",    "destination": "/install.html" },
    { "source": "/t/:slug/",           "destination": "/home.html" },
    { "source": "/t/:slug",            "destination": "/home.html" },
    { "source": "/admin",      "destination": "/admin.html" },
    { "source": "/scoreboard", "destination": "/scoreboard.html" },
    { "source": "/scorecard",  "destination": "/scorecard.html" },
    { "source": "/profile",    "destination": "/profile.html" },
    { "source": "/directory",  "destination": "/directory.html" },
    { "source": "/course",     "destination": "/course.html" },
    { "source": "/champions",  "destination": "/champions.html" },
    { "source": "/feed",       "destination": "/feed.html" },
    { "source": "/login",      "destination": "/login.html" },
    { "source": "/install",    "destination": "/install.html" },
    { "source": "/platform",          "destination": "/platform.html" },
    { "source": "/platform-manifest.json", "destination": "/platform-manifest.json" }
  ]
}
